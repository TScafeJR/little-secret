{
  "name": "little-secret",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build-storybook": "storybook build",
    "clean": "rm -fr node_modules && yarn cache clean",
    "dev": "vite",
    "fmt": "yarn prettier --write --log-level=warn .",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase:create-migration": "supabase db diff --use-migra -f \"${MIGRATION_NAME}.up\"",
    "supabase:push": "supabase db push",
    "supabase:reset": "supabase db reset",
    "supabase:srv-functions": "supabase functions serve",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --backup",
    "supabase:upgrade": "supabase link",
    "storybook": "storybook dev -p 6006",
    "test": "yarn playwright test",
    "test:e2e": "yarn playwright test",
    "test:e2e:external": "env PLAYWRIGHT_SKIP_WEB_SERVER=1 yarn playwright test",
    "test:e2e:journey": "yarn playwright test src/tests/user-journey.spec.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "playwright:install": "playwright install chromium",
    "test:storybook": "vitest run --workspace vitest.storybook.workspace.ts",
    "test:ci": "CI=true yarn playwright test --ui",
    "test:ui": "yarn playwright test --ui",
    "test:report": "yarn playwright show-report"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.0",
    "random-words": "2.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TScafeJR/little-secret.git"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.1.2",
    "@eslint/js": "9.23.0",
    "@playwright/test": "1.51.1",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-mcp": "0.6.0",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.13.17",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react-swc": "3.7.0",
    "@vitest/browser": "3.1.1",
    "@vitest/coverage-v8": "3.1.1",
    "eslint": "9.23.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-storybook": "0.12.0",
    "globals": "16.0.0",
    "jsdom": "29.0.2",
    "playwright": "1.51.1",
    "prettier": "3.5.3",
    "storybook": "10.3.5",
    "supabase": "2.20.5",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0",
    "vite": "6.2.4",
    "vitest": "3.1.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
