{
  "name": "little-secret",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build-storybook": "storybook build",
    "clean": "rm -fr node_modules && yarn cache clean",
    "dev": "vite",
    "fmt": "yarn prettier --write --log-level=warn .",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase:create-migration": "supabase db diff --use-migra -f \"${MIGRATION_NAME}.up\"",
    "supabase:push": "supabase db push",
    "supabase:reset": "supabase db reset",
    "supabase:srv-functions": "supabase functions serve",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --backup",
    "supabase:upgrade": "supabase link",
    "storybook": "storybook dev -p 6006",
    "test": "yarn playwright test",
    "test:ui": "yarn playwright test --ui",
    "test:report": "yarn playwright show-report"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.0.15",
    "random-words": "2.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TScafeJR/little-secret.git"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3",
    "@eslint/js": "9.21.0",
    "@playwright/test": "1.51.1",
    "@storybook/addon-essentials": "8.6.10",
    "@storybook/blocks": "8.6.10",
    "@storybook/experimental-addon-test": "8.6.10",
    "@storybook/react": "8.6.10",
    "@storybook/react-vite": "8.6.10",
    "@storybook/test": "8.6.10",
    "@types/node": "22.13.14",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/browser": "3.0.9",
    "@vitest/coverage-v8": "3.0.9",
    "eslint": "9.21.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-storybook": "0.12.0",
    "globals": "15.15.0",
    "playwright": "1.51.1",
    "prettier": "3.5.3",
    "storybook": "8.6.10",
    "supabase": "2.20.5",
    "typescript": "5.7.2",
    "typescript-eslint": "8.24.1",
    "vite": "6.2.3",
    "vitest": "3.0.9"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
